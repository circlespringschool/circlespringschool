{
  "version": 2,
  "builds": [
    {
      "src": "**/*.{html,css,js,svg,png,jpg,jpeg,gif,webp,woff,woff2,eot,ttf,otf,json,ico}",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "."
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}